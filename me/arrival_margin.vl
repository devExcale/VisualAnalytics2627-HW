{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Margin of Arrival (positive = early / negative = late)",
  "width": 250,
  "height": 250,
  "data": {
    "url": "HW_030_scaccia.2006749.csv"
  },
  "transform": [
    {
      "filter": "datum.student_id == 'S1'"
    }
  ],
  "mark": {
    "type": "point",
    "filled": true
  },
  "encoding": {
    "x": {
      "title": "Distance (km)",
      "field": "distance_km",
      "type": "quantitative"
    },
    "y": {
      "title": "Arrival margin (min)",
      "field": "arrival_margin_min",
      "type": "quantitative",
      "scale": {
        "domain": [
          -20,
          20
        ]
      }
    },
    "shape": {
      "title": "Transport",
      "field": "mode"
    }
  }
}
