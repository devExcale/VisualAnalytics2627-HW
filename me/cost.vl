{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Leaving Time vs Arrival Margin",
  "width": 350,
  "height": 250,
  "data": {
    "url": "HW_030_scaccia.2006749.csv",
    "format": {
      "type": "csv",
      "parse": {
        "duration_min": "number",
        "arrival_margin_min": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.student_id == 'S1'"
    },
    {
      "calculate": "datum.duration_min + datum.arrival_margin_min",
      "as": "leaving_time_min"
    }
  ],
  "hconcat": [
    {
      "layer": [
        {
          "mark": {
            "type": "point",
            "filled": true
          },
          "encoding": {
            "x": {
              "title": "Leaving Time (min)",
              "field": "leaving_time_min",
              "type": "quantitative",
              "sort": "descending",
              "scale": {
                "zero": false,
                "padding": 15
              }
            },
            "y": {
              "title": "Arrival Margin (min)",
              "field": "arrival_margin_min",
              "type": "quantitative",
              "scale": {
                "padding": 15
              }
            },
            "shape": {
              "title": "Transport",
              "field": "mode",
              "type": "nominal"
            },
            "size": {
              "value": 85
            },
            "color": {
              "title": "Day of the week",
              "field": "date",
              "type": "nominal",
              "timeUnit": "day",
              "scale": {
                "scheme": "observable10"
              }
            },
            "tooltip": {
              "field": "arrival_margin_min"
            }
          }
        },
        {
          "mark": {
            "type": "rule",
            "color": "red",
            "strokeWidth": 1.5,
            "strokeDash": [
              4,
              4
            ]
          },
          "encoding": {
            "y": {
              "datum": 0
            }
          }
        }
      ]
    },
    {
      "layer": [
        {
          "mark": "boxplot",
          "encoding": {
            "x": {
              "title": "Transport",
              "field": "mode",
              "type": "nominal",
              "scale": {
                "padding": 1
              }
            },
            "y": {
              "title": "Arrival Margin (min)",
              "field": "arrival_margin_min",
              "type": "quantitative",
              "scale": {
                "padding": 15
              }
            }
          }
        },
        {
          "mark": {
            "type": "rule",
            "color": "red",
            "strokeWidth": 1.5,
            "strokeDash": [
              4,
              4
            ]
          },
          "encoding": {
            "y": {
              "datum": 0
            }
          }
        }
      ]
    }
  ]
}
