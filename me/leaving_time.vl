{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Arrival Margin wrt Leaving Time (TODO: add rules/lines legend)",
  "data": {
    "url": "HW_030_scaccia.2006749.csv",
    "format": {
      "type": "csv",
      "parse": {
        "duration_min": "number",
        "arrival_margin_min": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.student_id == 'S1'"
    },
    {
      "calculate": "datum.duration_min + datum.arrival_margin_min",
      "as": "leaving_time_min"
    }
  ],
  "hconcat": [
    {
      "layer": [
        {
          "mark": {
            "type": "point",
            "filled": true
          },
          "encoding": {
            "x": {
              "title": "Leaving Time (min)",
              "field": "leaving_time_min",
              "type": "quantitative",
              "sort": "descending",
              "scale": {
                "zero": false,
                "padding": 15
              }
            },
            "y": {
              "title": "Arrival Margin (min)",
              "field": "arrival_margin_min",
              "type": "quantitative",
              "scale": {
                "padding": 15
              }
            },
            "shape": {
              "title": "Transport",
              "field": "mode",
              "type": "nominal"
            },
            "size": {
              "value": 85
            },
            "fill": {
              "title": "Day of the week",
              "field": "date",
              "type": "nominal",
              "timeUnit": "day",
              "scale": {
                "scheme": "observable10"
              }
            },
            "tooltip": {
              "field": "arrival_margin_min"
            }
          }
        },
        {
          "transform": [
            {
              "aggregate": [
                {
                  "op": "mean",
                  "field": "arrival_margin_min",
                  "as": "mean_val"
                },
                {
                  "op": "stdev",
                  "field": "arrival_margin_min",
                  "as": "std_val"
                }
              ]
            },
            {
              "calculate": "datum.mean_val",
              "as": "Mean"
            },
            {
              "calculate": "datum.mean_val + 2 * datum.std_val",
              "as": "+2 Std Dev"
            },
            {
              "calculate": "datum.mean_val - 2 * datum.std_val",
              "as": "-2 Std Dev"
            },
            {
              "calculate": "0",
              "as": "y = 0 (above: on time, below: late)"
            },
            {
              "fold": [
                "y = 0 (above: on time, below: late)",
                "Mean",
                "+2 Std Dev",
                "-2 Std Dev"
              ],
              "as": [
                "rule",
                "val"
              ]
            }
          ],
          "mark": {
            "type": "rule",
            "strokeWidth": 1.5
          },
          "encoding": {
            "y": {
              "field": "val",
              "type": "quantitative"
            },
            "color": {
              "title": "Reference Rules",
              "field": "rule",
              "type": "nominal",
              "scale": {
                "domain": [
                  "y = 0 (above: on time, below: late)",
                  "Mean",
                  "+2 Std Dev",
                  "-2 Std Dev"
                ],
                "range": [
                  "#e41a1c",
                  "#377eb8",
                  "#ff7f00",
                  "#984ea3"
                ]
              }
            },
            "strokeDash": {
              "field": "rule",
              "type": "nominal",
              "scale": {
                "domain": [
                  "y = 0 (above: on time, below: late)",
                  "Mean",
                  "+2 Std Dev",
                  "-2 Std Dev"
                ],
                "range": [
                  [
                    4,
                    4
                  ],
                  [
                    0,
                    0
                  ],
                  [
                    3,
                    3
                  ],
                  [
                    3,
                    3
                  ]
                ]
              },
              "legend": null
            }
          }
        }
      ]
    },
    {
      "layer": [
        {
          "mark": "boxplot",
          "encoding": {
            "x": {
              "title": "Transport",
              "field": "mode",
              "type": "nominal",
              "scale": {
                "padding": 1
              }
            },
            "y": {
              "title": "Arrival Margin (min)",
              "field": "arrival_margin_min",
              "type": "quantitative",
              "scale": {
                "padding": 15
              }
            }
          }
        },
        {
          "transform": [
            {
              "aggregate": [
                {
                  "op": "mean",
                  "field": "arrival_margin_min",
                  "as": "mean_val"
                },
                {
                  "op": "stdev",
                  "field": "arrival_margin_min",
                  "as": "std_val"
                }
              ]
            },
            {
              "calculate": "datum.mean_val",
              "as": "Mean"
            },
            {
              "calculate": "datum.mean_val + 2 * datum.std_val",
              "as": "+2 Std Dev"
            },
            {
              "calculate": "datum.mean_val - 2 * datum.std_val",
              "as": "-2 Std Dev"
            },
            {
              "calculate": "0",
              "as": "y = 0 (above: on time, below: late)"
            },
            {
              "fold": [
                "y = 0 (above: on time, below: late)",
                "Mean",
                "+2 Std Dev",
                "-2 Std Dev"
              ],
              "as": [
                "rule",
                "val"
              ]
            }
          ],
          "mark": {
            "type": "rule",
            "strokeWidth": 1.5
          },
          "encoding": {
            "y": {
              "field": "val",
              "type": "quantitative"
            },
            "color": {
              "title": "Reference Rules",
              "field": "rule",
              "type": "nominal",
              "scale": {
                "domain": [
                  "y = 0 (above: on time, below: late)",
                  "Mean",
                  "+2 Std Dev",
                  "-2 Std Dev"
                ],
                "range": [
                  "#e41a1c",
                  "#377eb8",
                  "#ff7f00",
                  "#984ea3"
                ]
              }
            },
            "strokeDash": {
              "field": "rule",
              "type": "nominal",
              "scale": {
                "domain": [
                  "y = 0 (above: on time, below: late)",
                  "Mean",
                  "+2 Std Dev",
                  "-2 Std Dev"
                ],
                "range": [
                  [
                    4,
                    4
                  ],
                  [
                    0,
                    0
                  ],
                  [
                    3,
                    3
                  ],
                  [
                    3,
                    3
                  ]
                ]
              },
              "legend": null
            }
          }
        }
      ]
    }
  ]
}
