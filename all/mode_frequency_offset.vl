{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Margin of Arrival (positive = early / negative = late)",
  "width": 350,
  "height": 250,
  "data": {
    "url": "HW_030_scaccia.2006749.csv"
  },
  "mark": {
    "type": "bar"
  },
  "encoding": {
    "x": {
      "title": "Transport",
      "field": "mode",
      "type": "nominal"
    },
    "y": {
      "aggregate": "count",
      "scale": {
        "domain": [
          0,
          15
        ]
      }
    },
    "color": {
      "title": "Student",
      "field": "student_id",
      "type": "nominal"
    },
    "xOffset": {
      "field": "student_id"
    }
  }
}
