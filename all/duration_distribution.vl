{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Student Commute Duration by Mode (S1 - S4)",
    "subtitle": [
      "Commute duration distributions by mode across students, ordered by average distance",
      "Boxplot width is proportional to trip mode count"
    ],
    "anchor": "middle",
    "fontSize": 14,
    "subtitleFontSize": 11,
    "subtitleColor": "#666666",
    "subtitleLineHeight": 14
  },
  "data": {
    "url": "HW_030_scaccia.2006749.csv",
    "format": {
      "type": "csv",
      "parse": {
        "duration_min": "number",
        "arrival_margin_min": "number",
        "distance_km": "number",
        "cost_eur": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.arrival_margin_min < 0 ? 'Late' : 'On-Time'",
      "as": "punctuality_status"
    },
    {
      "joinaggregate": [
        {
          "op": "q1",
          "field": "duration_min",
          "as": "q1_duration"
        },
        {
          "op": "q3",
          "field": "duration_min",
          "as": "q3_duration"
        }
      ],
      "groupby": [
        "student_id",
        "mode"
      ]
    },
    {
      "calculate": "datum.q3_duration + 1.5 * (datum.q3_duration - datum.q1_duration)",
      "as": "upper_whisker"
    },
    {
      "calculate": "datum.q1_duration - 1.5 * (datum.q3_duration - datum.q1_duration)",
      "as": "lower_whisker"
    },
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "trip_count"
        }
      ],
      "groupby": [
        "student_id",
        "mode"
      ]
    }
  ],
  "width": 560,
  "height": 320,
  "layer": [
    {
      "description": "Dummy point to host Transport Mode legend first",
      "mark": {
        "type": "point",
        "opacity": 0,
        "size": 0
      },
      "encoding": {
        "color": {
          "field": "mode",
          "type": "nominal",
          "scale": {
            "domain": [
              "Bicycle",
              "Public transport",
              "Car",
              "Walk"
            ],
            "range": [
              "#2ca25f",
              "#756bb1",
              "#e6550d",
              "#3182bd"
            ]
          },
          "legend": {
            "title": "Transport Mode",
            "orient": "right",
            "symbolSize": 70,
            "symbolOpacity": 0.85,
            "titleFontSize": 11,
            "labelFontSize": 10
          }
        }
      }
    },
    {
      "description": "Duration Boxplots per Student and Mode",
      "mark": {
        "type": "boxplot",
        "opacity": 0.85,
        "outliers": false,
        "median": {
          "color": "#111111"
        },
        "ticks": false
      },
      "encoding": {
        "size": {
          "field": "trip_count",
          "type": "quantitative",
          "scale": {
            "domain": [0, 13],
            "range": [0, 20.8]
          },
          "legend": null
        },
        "x": {
          "field": "student_id",
          "type": "nominal",
          "sort": ["S4", "S3", "S1", "S2"],
          "axis": {
            "title": [
              "Student",
              "(Average distance)"
            ],
            "labelAngle": 0,
            "labelExpr": "datum.value == 'S4' ? ['S4', '(1.9 km)'] : datum.value == 'S3' ? ['S3', '(6.8 km)'] : datum.value == 'S1' ? ['S1', '(11.5 km)'] : ['S2', '(14.1 km)']",
            "titlePadding": 10
          }
        },
        "xOffset": {
          "field": "mode",
          "type": "nominal"
        },
        "y": {
          "field": "duration_min",
          "type": "quantitative",
          "scale": {
            "domain": [0, 70],
            "nice": false
          },
          "axis": {
            "title": "Commute duration (min)",
            "values": [
              0,
              5,
              10,
              15,
              20,
              25,
              30,
              35,
              40,
              45,
              50,
              55,
              60,
              65,
              70
            ],
            "tickCount": 15,
            "labelOverlap": false,
            "grid": true,
            "gridColor": "#f0f0f0"
          }
        },
        "color": {
          "field": "mode",
          "type": "nominal",
          "scale": {
            "domain": [
              "Bicycle",
              "Public transport",
              "Car",
              "Walk"
            ],
            "range": [
              "#2ca25f",
              "#756bb1",
              "#e6550d",
              "#3182bd"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "description": "Positive Duration Outliers (points) and Late Data Points (crosses) Colored by Mode",
      "transform": [
        {
          "filter": "datum.arrival_margin_min < 0 || datum.duration_min > datum.upper_whisker || datum.duration_min < datum.lower_whisker"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 55,
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      },
      "encoding": {
        "x": {
          "field": "student_id",
          "type": "nominal",
          "sort": ["S4", "S3", "S1", "S2"]
        },
        "xOffset": {
          "field": "mode",
          "type": "nominal"
        },
        "y": {
          "field": "duration_min",
          "type": "quantitative"
        },
        "color": {
          "field": "mode",
          "type": "nominal",
          "scale": {
            "domain": [
              "Bicycle",
              "Public transport",
              "Car",
              "Walk"
            ],
            "range": [
              "#2ca25f",
              "#756bb1",
              "#e6550d",
              "#3182bd"
            ]
          },
          "legend": null
        },
        "shape": {
          "field": "punctuality_status",
          "type": "nominal",
          "scale": {
            "domain": [
              "On-Time",
              "Late"
            ],
            "range": [
              "circle",
              "cross"
            ]
          },
          "legend": {
            "title": "Punctuality",
            "orient": "right",
            "symbolSize": 70,
            "titleFontSize": 11,
            "labelFontSize": 10
          }
        },
        "tooltip": [
          { "field": "student_id", "type": "nominal", "title": "Student" },
          { "field": "date", "type": "temporal", "format": "%a, %b %d", "title": "Date" },
          { "field": "mode", "type": "nominal", "title": "Mode" },
          { "field": "duration_min", "type": "quantitative", "title": "Duration (min)" },
          { "field": "arrival_margin_min", "type": "quantitative", "format": "+d", "title": "Arrival Margin (min)" },
          { "field": "punctuality_status", "type": "nominal", "title": "Status" },
          { "field": "distance_km", "type": "quantitative", "format": ".2f", "title": "Distance (km)" },
          { "field": "cost_eur", "type": "quantitative", "format": ".2f", "title": "Cost (€)" }
        ]
      }
    }
  ],
  "config": {
    "legend": {
      "margin": 3
    }
  }
}