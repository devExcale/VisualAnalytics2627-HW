{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Distance vs Cost",
  "width": 350,
  "height": 250,
  "data": {
    "url": "HW_030_scaccia.2006749.csv"
  },
  "mark": {
    "type": "point",
    "filled": true
  },
  "encoding": {
    "x": {
      "title": "Distance (km)",
      "field": "distance_km",
      "type": "quantitative"
    },
    "y": {
      "title": "Cost (eur)",
      "field": "cost_eur",
      "type": "quantitative"
    },
    "shape": {
      "title": "Transport",
      "field": "mode",
      "type": "nominal"
    },
    "size": {
      "value": 40
    },
    "color": {
      "field": "arrival_margin_min",
      "type": "quantitative",
      "scale": {
        "type": "linear",
        "domainMid": 0,
        "scheme": "redyellowblue"
      }
    },
    "row": {
      "title": "Student",
      "field": "student_id"
    }
  }
}
